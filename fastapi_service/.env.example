# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_BUCKET=your-bucket-name

# Textract
TEXTRACT_ASYNC_THRESHOLD_PAGES=2

# Bytez
BYTEZ_API_KEY=your_bytez_api_key
BYTEZ_MODEL=meta-llama/Llama-3.1-8B-Instruct
BYTEZ_MAX_TOKENS=512
BYTEZ_TEMPERATURE=0.1

# MLflow
# Local dev:  http://localhost:5000
# Docker:     overridden to http://mlflow:5000 via docker-compose.yml
MLFLOW_TRACKING_URI=http://localhost:5000

# App
LOG_LEVEL=INFO
ENVIRONMENT=development
