[Unit]
Description=FinanceHQ FastAPI service
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/FinanceHQ/fastapi_service
ExecStart=/home/ubuntu/FinanceHQ/venv_api/bin/uvicorn main:app --host 127.0.0.1 --port 8001 --workers 1
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
