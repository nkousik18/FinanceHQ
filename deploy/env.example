# AWS
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_REGION=us-east-1
S3_BUCKET=financehq

TEXTRACT_ASYNC_THRESHOLD_PAGES=2

# Groq
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=1024
GROQ_TEMPERATURE=0.1

# MLflow
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_ARTIFACT_BUCKET=financehq

# Django — replace <EC2_PUBLIC_IP> with your actual EC2 IP
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=<EC2_PUBLIC_IP>

# Must be the public URL the browser uses to reach FastAPI
FASTAPI_URL=http://<EC2_PUBLIC_IP>/api

LOG_LEVEL=INFO
ENVIRONMENT=production
