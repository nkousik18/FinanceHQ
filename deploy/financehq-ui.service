[Unit]
Description=FinanceHQ Django UI
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/FinanceHQ/django_frontend
ExecStart=/home/ubuntu/FinanceHQ/venv_ui/bin/gunicorn financehq_ui.wsgi:application --bind 127.0.0.1:8000 --workers 2
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
